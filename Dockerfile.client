FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    textual \
    typer \
    httpx \
    pydantic-settings \
    click \
    pillow

# Copy client code
COPY client/src /app/src

# Set environment
ENV ZEROOPS_SERVER_URL=http://server:8000
ENV ZEROOPS_SESSION_TOKEN=default-user

# Run client
CMD ["python", "src/main.py", "tui"]
