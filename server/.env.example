# ZeroOps Server Environment Variables
# Prefix ALL variables with ZEROOPS_ so pydantic-settings loads them correctly.

# Server Network Configuration
ZEROOPS_HOST=0.0.0.0
ZEROOPS_PORT=8000
ZEROOPS_DEBUG=false

# Workshop isolation. Use a different ID for every workshop deployment.
ZEROOPS_WORKSHOP_ID=git
# Optional: restrict repository linking to this workshop's repository.
# ZEROOPS_WORKSHOP_REPOSITORY=your-org/git-workshop

# GitHub OAuth App Credentials
# Create a GitHub OAuth App at https://github.com/settings/developers
# Set Authorization callback URL to: http://<server-ip-or-hostname>:8000/v1/auth/callback
ZEROOPS_GITHUB_CLIENT_ID=your_github_client_id_here
ZEROOPS_GITHUB_CLIENT_SECRET=your_github_client_secret_here

# JWT Signing & Session State Secret Key
# Generate a secure random hex key with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
ZEROOPS_SECRET_KEY=your_random_secret_key_here

# Database Configuration (Optional)
# Defaults to sqlite+aiosqlite:///<DATA_DIR>/<WORKSHOP_ID>.db if left unset
# ZEROOPS_DATABASE_URL=sqlite+aiosqlite:////home/user/.local/share/zeroops/zeroops.db
